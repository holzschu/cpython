@@ -87,6 +87,9 @@
 # Adding at project level causes many spurious -lgfortran flags.
 add_languages('fortran', native: false)
 ff = meson.get_compiler('fortran')
+# LLVM Flang does not accept Apple's framework or -dynamiclib driver flags.
+# The C linker uses the explicitly supplied iOS flang runtime instead.
+fortran_link_language = host_machine.system() == 'ios' and ff.get_id() == 'llvm-flang' ? 'c' : 'fortran'
 if ff.get_id() == 'gcc'
   # -std=legacy is not supported by all Fortran compilers, but very useful with
   # gfortran since it avoids a ton of warnings that we don't care about.
