{
  "libraries": [
    "zmq"
  ],
  "include_dirs": [
    "/usr/local/include",
    "zmq/utils"
  ],
  "library_dirs": [
    "/usr/local/lib"
  ],
  "runtime_library_dirs": [],
  "extra_link_args": [
    "-Wl,-rpath",
    "-Wl,/usr/local/lib",
